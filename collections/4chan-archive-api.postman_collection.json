          "id": "6d880262-b64a-4da4-a188-3742892752b3",
          "name": "4chan Get Board Archive",
          "request": {
            "name": "4chan Get Board Archive",
            "description": {
              "content": "Returns the list of archived (closed, read-only) thread OP numbers for the given board. Archived threads remain viewable until 4chan automatically deletes them. Not every board has archives enabled — boards without an archive return 404.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":board",
                "archive.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "board",
                  "description": "(Required) Board directory short name (e.g. `a`, `b`, `g`, `pol`, `po`, `v`). The full list of valid values is the `board` field on each entry in `/boards.json`."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
